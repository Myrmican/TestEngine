#include <windows.h>

#ifndef VS_VERSION_INFO
#define VS_VERSION_INFO 1
#endif

// IDI_ICON1               ICON    DISCARDABLE     ""

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    1,5,1,0
    PRODUCTVERSION 1,5,1,0
{
    BLOCK "StringFileInfo"
    {
       // U.S. English - Windows, Multilingual
       BLOCK "040904E4"
       {
          VALUE "FileDescription", "Cross-platform window customization framework"
          VALUE "FileVersion", "1.5.1.0"
          VALUE "ProductName", "QWindowKit"
          VALUE "ProductVersion", "1.5.1.0"
          VALUE "LegalCopyright", "Copyright 2023-present Stdware Collections"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x409, 1252 // 1252 = 0x04E4
    }
}
